generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "mysql"
}

enum UserRole {
  admin
  operator
}

enum ContentMode {
  shared
  exclusive
  exclusive_strict
}

enum TotemStatus {
  online
  offline
}

enum MediaStatus {
  active
  inactive
}

model Category {
  id        Int      @id @default(autoincrement())
  name      String   @unique @db.VarChar(100)
  createdAt DateTime @map("created_at")

  clients Client[]

  @@map("categories")
}

model Client {
  id         Int      @id @default(autoincrement())
  name       String   @db.VarChar(255)
  categoryId Int      @map("category_id")
  createdAt  DateTime @map("created_at")
  updatedAt  DateTime @map("updated_at")

  category Category @relation(fields: [categoryId], references: [id])
  totems   Totem[]
  media    Media[]

  @@index([categoryId])
  @@map("clients")
}

model User {
  id           Int      @id @default(autoincrement())
  name         String   @unique @db.VarChar(255)
  username     String   @unique @db.VarChar(255)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  role         UserRole @default(operator)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @map("created_at")
  updatedAt    DateTime @map("updated_at")

  @@index([username])
  @@map("users")
}

model Totem {
  id          Int         @id @default(autoincrement())
  clientId    Int         @map("client_id")
  name        String      @db.VarChar(255)
  location    String?     @db.VarChar(255)
  serial      String      @unique @db.VarChar(100)
  contentMode ContentMode @default(shared) @map("content_mode")
  status      TotemStatus @default(offline)
  lastSeenAt  DateTime?   @map("last_seen_at")
  createdAt   DateTime    @map("created_at")
  updatedAt   DateTime    @map("updated_at")

  client       Client           @relation(fields: [clientId], references: [id])
  credentials  TotemCredential[]
  playbackLogs PlaybackLog[]

  @@index([clientId])
  @@map("totems")
}

model TotemCredential {
  id         Int       @id @default(autoincrement())
  totemId    Int       @map("totem_id")
  deviceId   String    @unique @map("device_id") @db.VarChar(255)
  tokenHash  String    @map("token_hash") @db.VarChar(255)
  revokedAt  DateTime? @map("revoked_at")
  createdAt  DateTime  @map("created_at")

  totem Totem @relation(fields: [totemId], references: [id])

  @@index([deviceId])
  @@map("totem_credentials")
}

model Media {
  id        Int         @id @default(autoincrement())
  clientId  Int?        @map("client_id")
  title     String      @db.VarChar(255)
  filePath  String      @map("file_path") @db.VarChar(500)
  checksum  String      @db.VarChar(64)
  duration  Int
  weight    Int         @default(1)
  status    MediaStatus @default(active)
  createdAt DateTime    @map("created_at")
  updatedAt DateTime    @map("updated_at")

  client       Client?       @relation(fields: [clientId], references: [id])
  playbackLogs PlaybackLog[]

  @@index([clientId])
  @@index([status])
  @@map("media")
}

model PlaybackLog {
  id       Int      @id @default(autoincrement())
  totemId  Int      @map("totem_id")
  mediaId  Int      @map("media_id")
  playedAt DateTime @map("played_at")

  totem Totem @relation(fields: [totemId], references: [id])
  media Media @relation(fields: [mediaId], references: [id])

  @@index([totemId, playedAt])
  @@map("playback_logs")
}